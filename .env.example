# Porta exposta no servidor
PORT=3000

# Fuso horário do negócio
TZ=America/Sao_Paulo

# Opcional: define a senha do painel já no deploy (recomendado em servidores públicos).
# Se ficar vazio, a senha é criada na primeira visita a /admin.
ADMIN_PASSWORD=

# Opcional: envio automático de lembretes e avisos pelo WhatsApp via Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
REMINDER_HOURS_BEFORE=24
